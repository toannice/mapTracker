# Go
*.exe
*.test
*.out
server/out/
server/vendor/

# Kotlin / Gradle
client/.gradle/
client/build/
client/shared/build/
client/androidApp/build/
client/desktopApp/build/
*.class
*.jar
# ...except the Gradle wrapper jar, which every checkout needs to bootstrap
# Gradle at all. Without it CI fails with ClassNotFoundException:
# org.gradle.wrapper.GradleWrapperMain.
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.iml
.idea/
out/

# Docker
.dockerignore

# Env / secrets
.env
.env.*
*.env

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temp
*.tmp
*.swp
test_output.txt
test_control_*.txt

# Editor
.vscode/

# Build artifacts left at repo root by manual APK builds/adb installs
/*.apk

# Signing — NEVER commit keystores or their passwords
*.jks
*.keystore
!**/debug.keystore
keystore.properties
client/keystore.properties
client/local.properties
